# Copy this file to .env.local and fill in the values from your Supabase project:
# Supabase dashboard → Project Settings → API Keys / Data API.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_…). Safe for browsers: Row Level
# Security decides what it can read. (Older projects: the "anon" key also works.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts with sb_secret_…). SERVER ONLY — never prefix it with
# NEXT_PUBLIC_ and never commit it. Used by the seed script and /api/track.
# (Older projects: the "service_role" key also works.)
SUPABASE_SECRET_KEY=

# --- AI (menu import) -------------------------------------------------------
# Vercel AI Gateway key (Vercel dashboard → AI Gateway → API keys). SERVER ONLY.
# The gateway needs a payment method on the Vercel account before it serves
# requests (this also unlocks Vercel's free AI credits).
AI_GATEWAY_API_KEY=
# Optional: model used to read menus (gateway id). Default: anthropic/claude-opus-5.5
# AI_MENU_MODEL=
# Optional: talk to Anthropic directly instead of the gateway
# AI_GATEWAY_BASE_URL=https://api.anthropic.com

# Optional: public URL of the site, used in e-mail links when it can't be detected.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
